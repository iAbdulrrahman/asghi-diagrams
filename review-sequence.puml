@startuml
title Review and verification
autonumber

actor Reviewer as REV
participant "ReviewerProfile" as RP
participant "ReviewAssignment" as RA
participant "ReviewFeedback" as RF
participant "ReviewableContent" as C
participant "Passage" as P
actor Admin as ADM
actor Contributor as CON

REV -> RP : assignReview(contentId)
RP -> RA : new(reviewerId, contentId, isSpecialistReview)

break reviewer is the author
    RP --> REV : refused
end

REV -> RP : getAudioFile(recordingId)
RP --> REV : audioFile
REV -> RF : new(isFusha, dialectFree, audioQuality)

alt not Fusha or dialect present
    REV -> RA : recordDecision(false, reason)
else criteria met
    REV -> RA : recordDecision(isApproved, reason)
end

RA -> C : meetsThreshold()

alt threshold reached
    C -> C : changeStatus(VERIFIED)
else reviewers disagree
    C -> ADM : resolveDispute(reviewId, action)
    ADM --> C : decision
    C -> C : changeStatus(VERIFIED|REJECTED)
else still needs reviews
    C -> C : status stays PENDING_REVIEW
    note right : claim is kept while the recording is under review
end

opt verdict reached
    C -> P : releaseClaim()
    alt approved
        C --> CON : verdict VERIFIED
    else rejected
        C --> CON : verdict REJECTED and reason
        note right : re-record creates a new AudioRecording
    end
end

@enduml

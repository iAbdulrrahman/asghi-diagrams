@startuml
title Learner practice session
autonumber

actor Learner as L
participant "LearnerProfile" as LP
participant "TestSession" as TS
participant "LearnerProgress" as LPR
participant "Passage" as P
participant "QuestionResponse" as QR

L -> LP : startSession(passageId)
activate LP
LP -> TS : new(sessionId, passageId, startedAt)
activate TS
LP --> L : session
deactivate LP

L -> TS : fetchPassage(passageId)
TS --> L : passage text and audio

L -> TS : playAudio(playbackSpeed)

loop for each question in the test
    TS -> TS : nextQuestion()
    TS -> P : getQuestion(currentDifficulty)
    activate P
    P --> TS : question
    deactivate P
    TS --> L : question

    L -> TS : submitAnswer(questionId, answer)
    TS -> QR : new(questionId, submittedAnswer)
    activate QR
    QR -> QR : evaluate()
    QR --> TS : isCorrect
    deactivate QR
    TS -> TS : totalScore updated

    alt correct
        TS --> L : result with explanation
    else wrong
        TS --> L : correct answer with explanation
        TS -> TS : adaptDifficulty(isCorrect)
    end
end

L -> TS : finishSession()
TS -> TS : finishedAt = now
TS --> LP : session totals
deactivate TS
activate LP
LP -> LPR : totalScore, totalTimeSpent and currentStreakDays updated
activate LPR
deactivate LPR
deactivate LP

@enduml

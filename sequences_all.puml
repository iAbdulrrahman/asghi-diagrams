@startuml
skinparam dpi 150
title Claim and recording submission
autonumber

actor Contributor as CON
participant "ContributorProfile" as CP
participant "Passage" as P
participant "AudioRecording" as AR

CON -> CP : claim(passageId)
activate CP
CP -> P : claim(contributorId)
activate P
P -> P : isClaimExpired()

alt claimed by someone else and not expired
    P --> CP : false
else already has a VERIFIED or PENDING_REVIEW recording
    P --> CP : false
else free, or the previous claim expired
    P -> P : claimedBy = contributorId, claimedAt = now
    P -> P : changeStatus(CLAIMED)
    P --> CP : true
    note right : a claim expires CLAIM_TTL after claimedAt
end
deactivate P
CP --> CON : accepted or refused
deactivate CP

opt contributor abandons the claim
    CON -> CP : releaseClaim(passageId)
    activate CP
    CP -> P : releaseClaim()
    activate P
    P -> P : changeStatus(DRAFT)
    P -> P : claimedBy = null, claimedAt = null
    deactivate P
    CP --> CON : released
    deactivate CP
end

opt reading the passage first
    CON -> CP : toggleTashkeel()
    activate CP
    deactivate CP
end

CON -> CP : recordOrUploadAudio(passageId, audioFile)
activate CP
CP -> P : addAudio(audioFile)
activate P
P -> AR : new(audioFile, duration, attribution)
activate AR
AR -> AR : changeStatus(PENDING_REVIEW)
P -> P : changeStatus(PENDING_REVIEW)
P -> P : claimedAt = null
deactivate P
deactivate AR
deactivate CP

note right of P : clock stops, claim is held until the verdict

@enduml

@startuml
skinparam dpi 150
title Review and verification
autonumber

actor Reviewer as REV
participant "ReviewerProfile" as RP
participant "ReviewAssignment" as RA
participant "ReviewFeedback" as RF
participant "ReviewableContent" as C
participant "Passage" as P
participant "AdminProfile" as AP
actor Admin as ADM
actor Contributor as CON

REV -> RP : assignReview(contentId)
activate RP

break reviewer is the author
    RP --> REV : refused
end

RP -> RA : new(reviewerId, contentId, isSpecialistReview)
RP --> REV : assignment
deactivate RP

REV -> RP : getAudioFile(assignment)
activate RP
RP --> REV : audioFile
deactivate RP

REV -> RP : createFeedback(isFusha, dialectFree, audioQuality)
activate RP
RP -> RF : new(isFusha, dialectFree, audioQuality)
RP --> REV : feedback
deactivate RP

alt not Fusha or dialect present
    REV -> RP : submitDecision(assignment, feedback, false, reason)
    activate RP
    RP -> RA : recordDecision(feedback, false, reason)
    deactivate RP
else criteria met
    REV -> RP : submitDecision(assignment, feedback, isApproved, reason)
    activate RP
    RP -> RA : recordDecision(feedback, isApproved, reason)
    deactivate RP
end

activate RA
RA -> C : meetsThreshold()
deactivate RA
activate C

alt threshold reached
    C -> C : verify()
else reviewers disagree
    note over C : conflicting verdicts are escalated to the Admin
    ADM -> AP : resolveDispute(contentId, action)
    activate AP
    AP -> C : verify() | reject(reason)
    deactivate AP
else still needs reviews
    C -> C : status stays PENDING_REVIEW
    note right : claim is kept while the recording is under review
end
deactivate C

opt verdict reached
    C -> P : releaseClaim()
    activate P
    deactivate P
    alt approved
        C --> CON : verdict VERIFIED
    else rejected
        C --> CON : verdict REJECTED and reason
        note right : re-record creates a new AudioRecording
    end
end

@enduml

@startuml
skinparam dpi 150
title Learner practice session
autonumber

actor Learner as L
participant "LearnerProfile" as LP
participant "TestSession" as TS
participant "Passage" as P
participant "QuestionResponse" as QR
participant "LearnerProgress" as LPR

L -> LP : startSession(passageId)
activate LP
LP -> TS : new(sessionId, passageId, startedAt)
activate TS
LP --> L : session started
deactivate LP

L -> LP : fetchPassage(passageId)
activate LP
LP -> TS : fetchPassage(passageId)
LP --> L : passage text and audio
deactivate LP

L -> LP : playAudio(playbackSpeed)
activate LP
LP -> TS : playAudio(playbackSpeed)
deactivate LP

loop for each question in the test
    TS -> TS : nextQuestion()
    TS -> P : getQuestion(currentDifficulty)
    activate P
    P --> TS : question
    deactivate P
    TS --> LP : question
    LP --> L : question

    L -> LP : submitAnswer(questionId, answer)
    activate LP
    LP -> TS : submitAnswer(questionId, answer)
    TS -> QR : new(questionId, submittedAnswer)
    activate QR
    QR -> QR : evaluate()
    QR --> TS : isCorrect
    deactivate QR
    TS -> TS : totalScore updated

    alt correct
        TS --> LP : result with explanation
    else wrong
        TS --> LP : correct answer with explanation
        TS -> TS : adaptDifficulty(isCorrect)
    end
    LP --> L : feedback
    deactivate LP
end

L -> LP : finishSession()
activate LP
LP -> TS : finishSession()
TS -> TS : finishedAt = now
TS --> LP : session totals
deactivate TS
LP -> LPR : update(totalScore, timeSpent)
activate LPR
deactivate LPR
LP --> L : summary
deactivate LP

@enduml

@startuml
skinparam dpi 150
title User Registration and Role Granting
autonumber

actor "New User" as USR
participant "User" as U
participant "LearnerProfile" as LP
participant "ContributorProfile" as CP
participant "ReviewerProfile" as RP

USR -> U : register(emailOrPhone, password)
activate U
U --> USR : account created
deactivate U

USR -> U : completeProfile(displayName, level, roleInterest)
activate U
U -> U : displayName, arabicLevel and roleInterest set
U --> USR : profile saved
deactivate U

USR -> U : addRole(roleInterest)
activate U

alt role == LEARNER
    U -> LP : <<create>>(role)
    activate LP
    LP --> U : learnerProfile
    deactivate LP
else role == CONTRIBUTOR
    U -> CP : <<create>>(role)
    activate CP
    CP --> U : contributorProfile
    deactivate CP
else role == REVIEWER
    U -> RP : <<create>>(role)
    activate RP
    RP --> U : reviewerProfile
    deactivate RP
end

U --> USR : UserRoleProfile
deactivate U

@enduml

@startuml
skinparam dpi 150
title Content Flagging and Moderation
autonumber

actor Learner as LRN
participant "LearnerProfile" as LP
participant "ContentFlag" as CF
participant "ReviewableContent\n(abstract)" as RC
participant "AdminProfile" as AP
actor Admin as ADM

LRN -> LP : flagContent(content, reason)
activate LP
LP -> CF : <<create>>(content, reason, status = PENDING)
activate CF
CF --> LP : flagId
deactivate CF
LP --> LRN : flag submitted
deactivate LP

ADM -> AP : resolveFlag(flagId, newState)
activate AP
AP -> CF : resolve(newState)
activate CF
CF --> AP : updated
deactivate CF

alt newState == ACTION_TAKEN
    AP -> RC : markFlagged()
    activate RC
    RC --> AP : status = FLAGGED
    deactivate RC
else newState == NO_ACTION
    note right of AP : content status unchanged
end
deactivate AP

@enduml

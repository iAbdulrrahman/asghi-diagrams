@startuml
left to right direction
skinparam shadowing false
skinparam nodesep 18
skinparam ranksep 55
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #FDFDF5
  BorderColor #555555
}

actor "Learner" as Learner
actor "Contributor" as Contributor
actor "Reviewer" as Reviewer
actor "Admin" as Admin
actor "AI Engine" as AI

rectangle "Arabic Listening Practice App" {

  usecase "Register / manage profile" as UC_Account
  usecase "Browse and listen" as UC_Browse
  usecase "Take listening test" as UC_Test
  usecase "Track progress" as UC_Progress
  usecase "Flag content" as UC_Flag

  usecase "Claim and record passage" as UC_Record
  usecase "See rejection reason" as UC_Reject
  usecase "Author questions" as UC_Author

  usecase "Verify recording" as UC_Verify
  usecase "Review AI content" as UC_Review

  usecase "Manage catalogue, users and reputation" as UC_Admin
  usecase "Trigger AI generation" as UC_Gen

  usecase "Generate passage and questions" as UC_AIGen
}

Learner --> UC_Account
Learner --> UC_Browse
Learner --> UC_Test
Learner --> UC_Progress
Learner --> UC_Flag

Contributor --> UC_Record
Contributor --> UC_Reject
Contributor --> UC_Author

Reviewer --> UC_Verify
Reviewer --> UC_Review

Admin --> UC_Admin
Admin --> UC_Gen

AI --> UC_AIGen

@enduml
